# Generated by nft-gui: complete ruleset replacement
flush ruleset

table inet "filter" {
    comment "Routeur LAN → Internet (masquerade)";
    chain "input" {
        type filter hook input priority 0;
        policy drop;
    }
    chain "forward" {
        type filter hook forward priority 0;
        policy drop;
    }
    chain "output" {
        type filter hook output priority 0;
        policy accept;
    }
}
add rule inet "filter" "input" meta iifname "lo" counter accept comment "Boucle locale"
add rule inet "filter" "input" ct state { "invalid" } counter drop comment "Paquets invalides"
add rule inet "filter" "input" ct state { "established", "related" } counter accept comment "Connexions établies et liées"
add rule inet "filter" "input" meta l4proto "icmp" counter accept comment "ICMP IPv4"
add rule inet "filter" "input" meta l4proto "ipv6-icmp" counter accept comment "ICMP IPv6"
add rule inet "filter" "forward" ct state { "invalid" } counter drop comment "Transferts invalides"
add rule inet "filter" "forward" ct state { "established", "related" } counter accept comment "Réponses aux transferts autorisés"
add rule inet "filter" "forward" meta iifname "eth1" meta oifname "eth0" ip saddr 192.168.10.0/24 counter accept comment "LAN vers Internet"

table ip "nat" {
    chain "postrouting" {
        type nat hook postrouting priority 100;
        policy accept;
    }
}
add rule ip "nat" "postrouting" meta oifname "eth0" ip saddr 192.168.10.0/24 counter masquerade comment "Traduction de la source du LAN"
