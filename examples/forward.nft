# Example for an isolated lab. Complete ruleset replacement.
flush ruleset

table inet "filter" {
    counter "forwarded" {
        packets 0 bytes 0;
    }

    set "trusted" {
        type ipv4_addr;
        flags interval;
        elements = { 192.0.2.0/24 };
    }

    chain "forward" {
        type filter hook forward priority 0;
        policy drop;
        ct state established,related accept
        ip saddr @trusted counter name "forwarded" accept
    }
}
